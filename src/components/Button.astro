---
const { variant = "" } = Astro.props;

const isHero = variant === "hero";

const bgClass = isHero 
  ? "bg-white/20 text-black backdrop-blur-lg"  // Hero-knapper
  : "bg-[#2A292C] text-white backdrop-blur-lg"; // Alle andre

const borderClass = isHero ? "border border-white/30 text-white" : "border border-black/30";
---

<button class={`
  px-6 py-3 
  rounded-3xl 
  shadow-lg
  cursor-pointer  backdrop-blur-lg 
    hover:-translate-y-0.5 hover:shadow-xl

  ${bgClass}
  ${borderClass}
`}>
  <slot />
</button>




