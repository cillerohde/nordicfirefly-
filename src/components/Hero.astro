---
import Button from '../components/Button.astro';
import LightPost from "../assets/images/LightPost-for-landing2_original.png";
import Header from './Header.astro';
---

<section class="hero relative w-full min-h-screen overflow-hidden bg-black">

  <!-- Header placeres ovenpå hero -->
  <Header />

  <img 
    src={LightPost.src}
    alt="Baggrund"
    class="absolute inset-0 w-full h-full object-cover"
  />

 <article class="relative z-10 p-10 pt-[140px] md:pt-[180px] text-white max-w-7xl mx-auto">
    <h1 class="text-[100px]">NORDIC FIREFLY</h1>
    <h2 class="text-[45px]">
      Vi designer effektiv og pålidelig <br /> elektronik til solcelledrevne løsninger
    </h2>

    <div class="flex space-x-4 mt-6">
      <a href="/kontakt"><Button variant="hero">KONTAKT OS</Button></a>
      <a href="/produkt"><Button variant="hero">VORES PRODUKT</Button></a>
    </div>
</article>


</section>

