---
const { image, title, description, buttonText } = Astro.props;
import Button from "./Button.astro";
---

<div class="flex flex-col lg:flex-row gap-10 bg-customGray min-h-[400px]">
  <!-- Billedkolonne -->
  <div class="lg:w-1/2 flex items-center justify-center overflow-hidden">
    <img src={image} alt={title} class="w-full h-auto transition-opacity duration-1000" />
  </div>

  <!-- Tekstkolonne -->
  <div class="lg:w-1/2 flex flex-col justify-center px-10 lg:px-20 py-10">
    <p class="text-xl mb-4">{title}</p>
    <p class="mb-4">{description}</p>
    <div>
            {buttonText && <Button>{buttonText}</Button>}

  </div>
</div>
