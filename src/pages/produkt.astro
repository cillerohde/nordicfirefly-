---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import '../styles/tailwind.css';
import Index from "./index.astro";
import Button from "../components/Button.astro";
import Lightpost from "../assets/images/lightpost.webp";
const { title } = Astro.props;
---

<MainLayout>

   <div class="flex flex-col lg:flex-row gap-10">

  <!-- Billedkolonne -->
  <div class="lg:w-1/2 flex items-center justify-center overflow-hidden">
  <img id="slideshow" src={Lightpost.src} alt="Slideshow" class="w-full h-[800px] object-cover transition-opacity duration-1000">
</div>
<!-- Tekstkolonne -->
  <div class="lg:w-1/2 flex flex-col justify-center px-10 lg:px-20 mt-10">
    <p class="text-3xl mb-4">LIGHTPOST<br>Produktinformation</p>

    <p>Vores løsning leverer konstant og pålidelig synlighed året rundt 
<br> - også under begrænset vinterlys. 



<p><br> Den består af specialudviklet elektronik, effektive LED-moduler og et robust batteri, alle designet og testet til langtidsholdbar ydeevne i krævende miljøer. 
Løsningen kombinerer avanceret teknologi med driftssikkerhed, hvilket sikrer minimal vedligeholdelse og optimal funktionalitet over mange år.</p>
</p>
    <p class="mt-4"> <br> Få mere info ved at kontakte os</p>

<div class="py-10">
    <a href="/kontakt">  <Button>Kontakt os</Button></a>
</div>

  </div>

</div>


</MainLayout>

<script>
  const images = [
    '/src/assets/images/lightpost.webp',
    '/src/assets/images/produkt.webp',
    '/src/assets/images/produkt3.webp' // tilføj flere billeder her
  ];

  let currentIndex = 0;
  const slideshow = document.getElementById('slideshow');

  function nextImage() {
    // Fade ud
    slideshow.style.opacity = 0;

    // Efter fade out, skift billede og fade ind
    setTimeout(() => {
      currentIndex = (currentIndex + 1) % images.length;
      slideshow.src = images[currentIndex];
      slideshow.style.opacity = 1;
    }, 1000); // matcher transition-duration
  }

  // Skift billede hvert 5. sekund
  setInterval(nextImage, 5000);
</script>

