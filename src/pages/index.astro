</MainLayout>
<script>

  function countUp(id, end, duration = 3000) {
    const el = document.getElementById(id);
    let start = 0;
    const increment = end / (duration / 20);
    const timer = setInterval(() => {
      start += increment;
      if (start >= end) {
        start = end;
        clearInterval(timer);
      }
      el.innerText = Math.floor(start).toLocaleString() + 
                     (id === 'count2' ? 't' : id === 'count3' ? ' år' : '+');
    }, 20);
  }

  // Funktion som observerer sektionen
  const statsSection = document.getElementById('stats-section');

  const observer = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          countUp('count1', 1500);
          countUp('count2', 42500);
          countUp('count3', 10);
          observer.unobserve(entry.target); // sørger for animation kun kører én gang
        }
      });
    },
    { threshold: 0.5 } // 
  );

 observer.observe(statsSection);

// ---- PRODUKT SLIDESHOW (ASTRO-SIKKER) ----
const produktSlideshow = document.getElementById("slideshow-produkter");

// læs billed-urls fra data-attributten
const produktImages = produktSlideshow.dataset.images.split(",");

let produktIndex = 0;

function nextProduktImage() {
  produktSlideshow.style.opacity = 0;

  setTimeout(() => {
    produktIndex = (produktIndex + 1) % produktImages.length;
    produktSlideshow.src = produktImages[produktIndex];
    produktSlideshow.style.opacity = 1;
  }, 500);
}

setInterval(nextProduktImage, 4000);

</script>
