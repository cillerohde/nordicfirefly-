---
// frontmatter (din eksisterende)
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import Link from '../components/Link.astro';
import Header from "../components/Header.astro";
import { Image } from 'astro:assets';
import '../styles/tailwind.css';
import Cases from "./cases.astro";
import Kontakt from "./kontakt.astro";
import thumbsup from "../assets/images/thumbsup.png";
import LightPost from "../assets/images/LightPost-for-landing2_original.png";
---


<section class="relative w-full min-h-screen overflow-hidden bg-black">

  <img 
    src={LightPost.src}
    alt="Baggrund"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <!-- Header skal ligge OVER billedet -->
  <div class="relative z-20">
    <Header />
  </div>

  <article class="relative z-10 p-10 text-white">
    <h1 class="text-[100px]">NORDIC FIREFLY</h1>
    <h2 class="text-[45px]">
      Vi designer effektiv og pålidelig <br /> elektronik til solcelledrevne løsninger
    </h2>

    <div class="flex space-x-4 mt-6">
    <Button>KONTAKT OS</Button>
    <Button>VORES PRODUKT</Button>
  </div>
  </article>

</section>

<section class="p-10">

<p class="mt-4 text-[25px]" >Vores teknologi er den eneste på markedet med disse fremragende resultater.</p>
<Button class="mt-12">SE VORES CASES HER</Button>

<div class="flex justify-between mt-12">
  <div class="flex flex-col items-center">
    <h1 class="text-[100px]">1500+</h1>
    <p class="text-left max-w-xs">
      Vi har leveret solcelledrevne lysbokse til Trygfondens redningsstiger siden 2019.
    </p>
  </div>

  <div class="flex flex-col items-center">
    <h1 class="text-[100px]">42.500t</h1>
    <p class="text-left max-w-xs">
      De har lyst gennem alle årets mørke timer uden én eneste reparation eller batteriskift.
    </p>
  </div>

  <div class="flex flex-col items-center">
    <h1 class="text-[100px]">10-15 år</h1>
    <p class="text-left max-w-xs">
      Vi forventer, at batterierne holder mindst 10–15 år endnu. Lightpost bruger samme teknologi og har samme forventede levetid.
    </p>
  </div>
</div>

</section>

<section class="p-10">

<h2 class="mt-4 text-[25px]">Vores produkt</h2>

<div class="flex flex-col lg:flex-row gap-10 mt-6">
  <!-- Billedkolonne -->
  <div class="flex-1">
    <img src="/src/assets/images/produkt.png" alt="">

	<p>Solar driven path and street lighting for off-grid installation</p>
  </div>

  <!-- Tekstkolonne -->
  <div class="flex-1">
    <p>LIGHTPOST<br>Produktinformation</p>

    <ul class="list-disc ml-6 mt-4 space-y-2">
      <li>Ledelys til orientering om stiers forløb</li>
      <li>Synliggøre særlige fokuspunkter</li>
      <li>Solcelledrevet LED lys</li>
      <li>Kabelfri</li>
      <li>Automatisk tænd/sluk</li>
      <li>Automatisk årstidstilpasning</li>
      <li>Hensyntagen til biodiversiteten og dyrelivet</li>
      <li>Minimal lysforurening</li>
      <li>Synlighed i høj bevoksning</li>
      <li>Opfylder kravene til belysning i miljøzoner og klasse E4</li>
      <li>Plug-n-Play installation</li>
      <li>Designet og udviklet i Danmark</li>
    </ul>

    <p class="mt-4">Få mere info ved at kontakte os</p>
  </div>
</div>

</section>



<section class="p-10" >
<p class="mt-4 text-[25px]" >TEAMET</p>
<p class="">
      NORDIC FIREFLY A/S er et spin-out selskab fra Danmarks Tekniske Universitet (DTU). Virksomheden er grundlagt på DTU-patenteret teknologi og dyb teknisk ekspertise inden for udvikling af effektiv effekt-elektronik til solpaneler, batterier og LED.
    </p>


<div class="flex flex-wrap gap-6">
  <!-- Person 1 -->
  <div class="flex flex-col items-start">
    <img src="/src/assets/images/img1.png" alt="">
    <p>Jørgen Kejlberg</p>
    <p>CEO</p>
    <p>jk@nordicfirefly.com</p>
  </div>

  <!-- Person 2 -->
  <div class="flex flex-col items-start">
    <img src="/src/assets/images/img2.png" alt="">
    <p>Jørgen Kejlberg</p>
    <p>CEO</p>
    <p>jk@nordicfirefly.com</p>
  </div>

  <!-- Person 3 -->
  <div class="flex flex-col items-start">
    <img src="/src/assets/images/img3.png" alt="">
    <p>Jørgen Kejlberg</p>
    <p>CEO</p>
    <p>jk@nordicfirefly.com</p>
  </div>

  <!-- Person 4 -->
  <div class="flex flex-col items-start">
    <img src="/src/assets/images/img4.png" alt="">
    <p>Jørgen Kejlberg</p>
    <p>CEO</p>
    <p>jk@nordicfirefly.com</p>
  </div>
</div>


</section>


<section class="p-10">
  <div class="flex flex-col lg:flex-row gap-10">
    <!-- Venstre kolonne -->
    <div class="flex-1 flex flex-col gap-4">
      <p class="mt-4 text-[25px]">Skal vi hjælpe jeres virksomhed næste gang?</p>
      <p>
        Hos Nordic Firefly sælger vi vores egen innovation, Lightpost, og vi tilbyder også at integrere vores unikke teknologi direkte i jeres produkter. Ønsker I, at vi hjælper jeres virksomhed med dette, er I velkomne til at kontakte os.
      </p>
      <Button class="w-auto px-6">KONTAKT OS</Button>
    </div>

    <!-- Højre kolonne -->
    <div class="flex-1 flex flex-col gap-4">
      <p class="mt-4 text-[25px]">Se alle vores tidligere cases her og hvad vi tilbyder.</p>
      <p class="mt-4 text-[25px]">Vores services & løsninger</p>
      <p class="mt-4 text-[25px]">CASES</p>
    </div>
  </div>
</section>
