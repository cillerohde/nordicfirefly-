---
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import Kontakt from "./kontakt.astro";
import thumbsup from "../assets/images/thumbsup.png";
import LightPost from "../assets/images/LightPost-for-landing2_original.png";
import Havn from "../assets/images/Havn.webp";
import DF from "../assets/images/df.webp";
import Card from "../components/Card.astro";
const { title } = Astro.props;
---

<MainLayout>


<section class="p-10">
  <div class="flex flex-col lg:flex-row gap-10">
    <!-- Venstre kolonne -->
    <div class="flex-1 flex flex-col gap-4">
      <p class="mt-4 text-[45px]">CASES</p>
      <p>
Her kan du se vores samarbejder med virksomheder, der har integreret vores teknologi i deres produkter for at løse deres udfordringer.
</p>
<div>
      <a href="/kontakt"><Button class="w-auto px-6">KONTAKT OS</Button></a>
</div>
    </div>

    <!-- Højre kolonne -->
    <div class="flex-1 flex flex-col gap-4 px-10">
	  
     <a href="#hvad-vi-tilbyder" class="flex items-center mt-4 text-[25px] gap-2 scroll-smooth">
  <img src="/src/assets/images/arrow.svg" alt="">
  <span>Vores services & løsninger</span>
</a>

<a href="#rescue-ladder" class="flex items-center mt-4 text-[25px] gap-2">
  <img src="/src/assets/images/arrow.svg" alt="">
  <span>Rescue Ladder</span>
</a>


<a href="#drinking-fountains" class="flex items-center mt-4 text-[25px] gap-2">
  <img src="/src/assets/images/arrow.svg" alt="">
  <span>Drinking fountains</span>
</a>

    </div>
  </div>
</section>

<section class="p-10">
<h1 id="hvad-vi-tilbyder" class="text-[45px]">HVAD VI TILBYDER</h1>

<div class="flex flex-col lg:flex-row gap-10">
<div class="flex-1 flex flex-col gap-4">
        <p class="mt-4 text-[25px]">Prototyping</p>
      <p>
Vi sammensætter hurtigt en prototype baseret på vores kompetencer <br>og tidligere erfaringer ved brug af vores eksisterende komponentudvalg.</p>

 <p class="mt-4 text-[25px]">Produktion</p>
      <p>
Vi udfører den endelige samling internt, <br> hvor produktet gennemgår grundig konfiguration og test.</p>

 <p class="mt-4 text-[25px]">Mekanik</p>
      <p>
Vi designer pålidelige mekaniske løsninger med høj grad af tilpasning <br>og integration af hardware og software.</p>
</div>



<div class="flex-1 flex flex-col gap-4">

<p class="mt-4 text-[25px]">Hardware</p>
      <p>
Vi bruger elektroniske komponenter, batterier, solpaneler og LED’er af høj kvalitet,<br>som er både effektive og pålidelige.</p>

<p class="mt-4 text-[25px]">Software</p>
      <p>
Vi maksimerer ydeevnen af vores komponenter gennem egenudviklet software, <br> der spænder fra intelligent styring til fjernovervågning via IoT.</p>

</div>
</div>
</section>

























<div id="rescue-ladder" class="flex flex-col lg:flex-row min-h-[400px]">

  <div class="lg:w-1/2 flex items-center justify-center overflow-hidden">
    <img src="/src/assets/images/Havn.webp" alt="" class="w-full h-auto transition-opacity duration-1000">
  </div>
  <div class="lg:w-1/2 flex flex-col justify-center lg:px-20 bg-zinc-100">
    <p class="text-3xl mb-4">Rescue Ladder<br></p>
    <p class="text-2xl mb-4">Produktinformation</p>
   <p>Vores løsning leverer konstant og pålidelig synlighed året rundt <br>
   - også under begrænset vinterlys. 

   <br>
    <br>
    Den består af specialudviklet elektronik, effektive LED-moduler og et robust batteri, alle designet og testet til langtidsholdbar ydeevne i krævende miljøer. 
    Løsningen kombinerer avanceret teknologi med driftssikkerhed, hvilket sikrer minimal vedligeholdelse og optimal funktionalitet over mange år.</p>

    <p class="mt-4">Få mere info ved at kontakte os</p>

  <div class="py-10">
      <a href="/kontakt"><Button class="w-auto px-6">KONTAKT OS</Button></a>
  </div>

  </div>

</div>


<div id="drinking-fountains" class="flex flex-col lg:flex-row  min-h-[400px]">

  <!-- Billedkolonne -->
  <div class="lg:w-1/2 flex items-center justify-center overflow-hidden">
  <img id="slideshow" src="/src/assets/images/df.webp" alt="Slideshow" class="w-full h-auto transition-opacity duration-1000">
</div>
<!-- Tekstkolonne -->
  <div class="lg:w-1/2 flex flex-col justify-center lg:px-20 bg-zinc-100">
    <p class="text-3xl mb-4">Drinking fountains<br>
<p class="text-2xl mb-4">Produktinformation</p>

   <p>Drikkefontæner i offentlige rum Solcelledrevet sensorstyring til drikkefontæner. <br>
 Solcelledrevet løsning til Fokdals sensorstyrede drikkefontæne. <br>
Et skjult solpanel og elektronik styrer intelligent opladning af batteriet og muliggør sensorstyret tænd/sluk-funktion af fontænen.</p>

    <p class="mt-4">Få mere info ved at kontakte os</p>

<div class="py-10">
      <a href="/kontakt"><Button class="w-auto px-6">KONTAKT OS</Button></a>
</div>

  </div>

</div>


</MainLayout>
