---
import MainLayout from "../layouts/MainLayout.astro";
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import Kontakt from "./kontakt.astro";
import thumbsup from "../assets/images/thumbsup.png";
import LightPost from "../assets/images/LightPost-for-landing2_original.png";
import Card from "../components/Card.astro";
const { title } = Astro.props;
---

<MainLayout>


<section class="p-10">
  <div class="flex flex-col lg:flex-row gap-10">
    <!-- Venstre kolonne -->
    <div class="flex-1 flex flex-col gap-4">
      <p class="mt-4 text-[45px]">CASES</p>
      <p>
Her kan du se vores samarbejder med virksomheder, der har integreret vores teknologi i deres produkter for at løse deres udfordringer.
</p>
<div>
      <Button class="w-auto px-6">KONTAKT OS</Button>
</div>
    </div>

    <!-- Højre kolonne -->
    <div class="flex-1 flex flex-col gap-4 px-10">
	  
     <a href="/produkt" class="flex items-center mt-4 text-[25px] gap-2">
  <img src="/src/assets/images/arrow.svg" alt="">
  <span>Vores services & løsninger</span>
</a>

<a href="/cases" class="flex items-center mt-4 text-[25px] gap-2">
  <img src="/src/assets/images/arrow.svg" alt="">
  <span>Rescue Ladder</span>
</a>

<a href="/cases" class="flex items-center mt-4 text-[25px] gap-2">
  <img src="/src/assets/images/arrow.svg" alt="">
  <span>Drinking fountains</span>
</a>

    </div>
  </div>
</section>

<section class="p-10">
<h1 class="text-[45px]">HVAD VI TILBYDER</h1>

<div class="flex flex-col lg:flex-row gap-10">
<div class="flex-1 flex flex-col gap-4">
        <p class="mt-4 text-[25px]">Prototyping</p>
      <p>
Vi sammensætter hurtigt en prototype baseret på vores kompetencer <br>og tidligere erfaringer ved brug af vores eksisterende komponentudvalg.</p>

 <p class="mt-4 text-[25px]">Produktion</p>
      <p>
Vi udfører den endelige samling internt, <br> hvor produktet gennemgår grundig konfiguration og test.</p>

 <p class="mt-4 text-[25px]">Mekanik</p>
      <p>
Vi designer pålidelige mekaniske løsninger med høj grad af tilpasning <br>og integration af hardware og software.</p>
</div>



<div class="flex-1 flex flex-col gap-4">

<p class="mt-4 text-[25px]">Hardware</p>
      <p>
Vi bruger elektroniske komponenter, batterier, solpaneler og LED’er af høj kvalitet,<br>som er både effektive og pålidelige.</p>

<p class="mt-4 text-[25px]">Software</p>
      <p>
Vi maksimerer ydeevnen af vores komponenter gennem egenudviklet software, <br> der spænder fra intelligent styring til fjernovervågning via IoT.</p>

</div>
</div>
</section>




<section class="flex flex-col gap-10">
    <Card
      image={LightPost.src}
      title="LIGHTPOST Produktinformation"
      description="Ledelys til orientering om stiers forløb, solcelledrevet LED lys, kabelfri osv."
      buttonText="Kontakt os"
    />
    <Card
      
      title="PRODUKT Information"
      description="Her kan du indsætte beskrivelse af produktet eller teknologi."
      buttonText="Kontakt os"
    />
    <Card
      
      title="LIGHTPOST Feature"
      description="Her kan du indsætte en anden beskrivelse af feature eller teknologi."
      buttonText="Kontakt os"
    />
  </section>






















<div class="flex flex-col lg:flex-row gap-10 min-h-[400px] bg-customGray">

  <!-- Billedkolonne -->
  <div class="lg:w-1/2 flex items-center justify-center overflow-hidden">
  <img id="slideshow" src="/src/assets/images/lightpost.png" alt="Slideshow" class="w-full h-auto transition-opacity duration-1000">
</div>
<!-- Tekstkolonne -->
<div class="lg:w-1/2 flex flex-col justify-center px-10 lg:px-20 mt-10">
    <p class="text-xl mb-4">LIGHTPOST<br>Produktinformation</p>

    <ul class="list-disc space-y-1 ml-5">
      <li>Ledelys til orientering om stiers forløb</li>
      <li>Synliggøre særlige fokuspunkter</li>
      <li>Solcelledrevet LED lys</li>
      <li>Kabelfri</li>
      <li>Automatisk tænd/sluk</li>
      <li>Automatisk årstidstilpasning</li>
      <li>Hensyntagen til biodiversiteten og dyrelivet</li>
      <li>Minimal lysforurening</li>
      <li>Synlighed i høj bevoksning</li>
      <li>Opfylder kravene til belysning i miljøzoner og klasse E4</li>
      <li>Plug-n-Play installation</li>
      <li>Designet og udviklet i Danmark</li>
    </ul>

    <p class="mt-4">Få mere info ved at kontakte os</p>

<div class="py-10">
      <Button>Kontakt os</Button>
</div>

  </div>

</div>


<div class="flex flex-col lg:flex-row gap-10 min-h-[400px]">

  <!-- Billedkolonne -->
  <div class="lg:w-1/2 flex items-center justify-center overflow-hidden">
  <img id="slideshow" src="/src/assets/images/lightpost.png" alt="Slideshow" class="w-full h-auto transition-opacity duration-1000">
</div>
<!-- Tekstkolonne -->
  <div class="lg:w-1/2 flex flex-col justify-center px-10 lg:px-20 mt-10 bg-customGray">
    <p class="text-xl mb-4">LIGHTPOST<br>Produktinformation</p>

    <ul class="list-disc space-y-1 ml-5">
      <li>Ledelys til orientering om stiers forløb</li>
      <li>Synliggøre særlige fokuspunkter</li>
      <li>Solcelledrevet LED lys</li>
      <li>Kabelfri</li>
      <li>Automatisk tænd/sluk</li>
      <li>Automatisk årstidstilpasning</li>
      <li>Hensyntagen til biodiversiteten og dyrelivet</li>
      <li>Minimal lysforurening</li>
      <li>Synlighed i høj bevoksning</li>
      <li>Opfylder kravene til belysning i miljøzoner og klasse E4</li>
      <li>Plug-n-Play installation</li>
      <li>Designet og udviklet i Danmark</li>
    </ul>

    <p class="mt-4">Få mere info ved at kontakte os</p>

<div class="py-10">
      <Button>Kontakt os</Button>
</div>

  </div>

</div>


</MainLayout>
